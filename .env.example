# Copy to .env locally. Never commit secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
DATABASE_URL=postgres://pathway:replace-with-a-long-random-url-safe-password@127.0.0.1:5432/pathway
CORS_ORIGINS=http://localhost:8081,http://localhost:4173
HOST=127.0.0.1
PORT=3001
# Set only when you have configured providers. Container-local routing uses http://routing:8002.
ROUTING_URL=
GEOCODING_URL=
PROVIDER_CONTACT=Pathway self-hosted instance; replace-with-your-contact
# Put Expo variables in apps/mobile/.env; localhost is only for browser development.
# Leave blank to allow custom server selection. X-Center uses https://pathway.xcenter.it.
EXPO_PUBLIC_API_URL=
# Set production for the hosted build to disable the Developer Options entry point.
EXPO_PUBLIC_DISTRIBUTION=
EXPO_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Native Android map rendering requires a restricted Maps SDK key. Do not enable paid services without approval.
GOOGLE_MAPS_ANDROID_KEY=
# A future authorized release manifest URL. No production source is configured.
EXPO_PUBLIC_UPDATE_MANIFEST_URL=
