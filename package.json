{
  "name": "pathway",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "npm run dev -w @pathway/server",
    "dev": "npm run start -w @pathway/mobile",
    "web": "npm run web -w @pathway/mobile",
    "test": "tsx --test apps/server/test/*.test.ts packages/geospatial/test/*.test.ts apps/mobile/test/*.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w @pathway/mobile",
    "build:server": "tsc -p apps/server/tsconfig.json && node scripts/copy-schema.mjs",
    "export:web": "npm run export -w @pathway/mobile",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "assets": "node scripts/branding.mjs",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json}\" \"packages/**/*.ts\" \"scripts/*.{ts,mjs}\"",
    "uads:validate": "node scripts/validate-uads.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
