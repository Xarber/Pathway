{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "uadsVersion",
    "manifestVersion",
    "project",
    "features",
    "distribution",
    "quality",
    "requirements",
    "exceptions"
  ],
  "properties": {
    "uadsVersion": {
      "const": "sections-1-52"
    },
    "manifestVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "repository",
        "profiles",
        "framework",
        "platforms",
        "hosting"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "profiles": {
          "type": "array",
          "items": {
            "enum": [
              "mobile-app",
              "web-app",
              "backend-service",
              "desktop-app",
              "web-service",
              "cli-tool",
              "library",
              "hybrid"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "ios",
              "android",
              "web",
              "linux-server"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "hosting": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "partial",
          "pending",
          "implemented",
          "verified"
        ]
      }
    },
    "distribution": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "workflow",
        "budgets",
        "release"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "budgets": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applicability",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UADS-[A-Z]+-[0-9]{3}$"
          },
          "applicability": {
            "enum": [
              "required",
              "conditional",
              "optional",
              "not-applicable",
              "approved-exception"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "blocked",
              "not-applicable",
              "waived"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "reason",
          "risks",
          "mitigation",
          "approval",
          "approvalDate",
          "reviewDate",
          "reconsideration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "risks": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "string",
            "minLength": 1
          },
          "approvalDate": {
            "type": "string",
            "minLength": 1
          },
          "reviewDate": {
            "type": "string",
            "minLength": 1
          },
          "reconsideration": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    }
  }
}
